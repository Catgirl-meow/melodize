<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections: streaming from the Subsonic/Navidrome server,
	     cover art, Deezer and companion requests. Without this the sandbox
	     fails every request with "Operation not permitted, errno = 1". -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
