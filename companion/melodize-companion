#!/usr/bin/env python3
"""
melodize-companion  —  Navidrome file-management sidecar for Melodize.

Endpoints
---------
GET  /health                   liveness probe
DELETE /api/songs/{id}         delete a song from disk by Navidrome ID
POST /api/songs/download       download a song from a URL (requires yt-dlp)
GET  /api/songs/download/{id}  check download job status

Auth: X-API-Key header.
Config: /etc/melodize-companion/config.json
"""

import hashlib, hmac, http.server, json, logging, os, pathlib, re
import secrets, sqlite3, subprocess, sys, threading, time, urllib.parse
from concurrent.futures import ThreadPoolExecutor
from typing import Optional

from analysis_cache import AnalysisCache
from audio_analysis import analyze_song, generate_transition, analysis_jobs, estimate_mix_quality

# ---------------------------------------------------------------------------
CONFIG_PATH = "/etc/melodize-companion/config.json"

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s  %(levelname)-7s  %(message)s",
    handlers=[logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("melodize-companion")


def load_config() -> dict:
    with open(CONFIG_PATH) as f:
        cfg = json.load(f)
    required = ("api_key", "music_dir", "navidrome_db")
    for k in required:
        if not cfg.get(k):
            sys.exit(f"Config missing required key: {k}")
    return cfg


# ---------------------------------------------------------------------------
# Background download job registry

_jobs: dict[str, dict] = {}   # job_id -> {status, url, error, path}
_jobs_lock = threading.Lock()
_job_created: dict[str, float] = {}

# Finished jobs are kept this long so the app can still poll their result.
JOB_TTL_SECONDS = 6 * 3600
# Upper bound on concurrent yt-dlp/deemix processes.
MAX_CONCURRENT_DOWNLOADS = 3
_download_slots = threading.BoundedSemaphore(MAX_CONCURRENT_DOWNLOADS)

MAX_BODY_BYTES = 1 << 20
MAX_BATCH_SONG_IDS = 20000
_SQLITE_CHUNK = 500


def _prune_jobs() -> None:
    """Drop jobs older than JOB_TTL_SECONDS so the registry can't grow forever."""
    cutoff = time.time() - JOB_TTL_SECONDS
    with _jobs_lock:
        for jid in [j for j, t in _job_created.items() if t < cutoff]:
            _jobs.pop(jid, None)
            _job_created.pop(jid, None)


def _register_job(job_id: str, job: dict) -> None:
    _prune_jobs()
    with _jobs_lock:
        _jobs[job_id] = job
        _job_created[job_id] = time.time()


def _new_job(job_id: str, url: str) -> None:
    _register_job(job_id, {"status": "queued", "url": url, "error": None, "path": None})


def _host_of(url: str) -> str:
    try:
        return (urllib.parse.urlsplit(url).hostname or "").lower()
    except ValueError:
        return ""


def is_deezer_url(url: str) -> bool:
    """True only when the URL's host is deezer.com or a subdomain of it."""
    host = _host_of(url)
    return host == "deezer.com" or host.endswith(".deezer.com") or host == "deezer.page.link"


def validate_download_url(url: str) -> Optional[str]:
    """Return an error message if *url* must not be handed to yt-dlp/deemix.

    The URL ends up as a command-line argument, so anything that could be
    parsed as an option (``--exec ...``) or a non-network scheme is refused.
    """
    if len(url) > 2048:
        return "url is too long"
    if any(c.isspace() or ord(c) < 0x20 for c in url):
        return "url must not contain whitespace or control characters"
    try:
        parts = urllib.parse.urlsplit(url)
    except ValueError:
        return "url is not valid"
    if parts.scheme not in ("http", "https") or not parts.hostname:
        return "url must be an http(s) URL"
    return None


_ARL_RE = re.compile(r"^[A-Za-z0-9]{32,512}$")


def is_valid_arl(arl: str) -> bool:
    """Deezer ARLs are long hex strings; reject anything that could smuggle
    extra cookies or curl config directives."""
    return bool(_ARL_RE.match(arl))


def _update_job(job_id: str, **kwargs) -> None:
    with _jobs_lock:
        job = _jobs.get(job_id)
        if job is not None:
            job.update(kwargs)


# Writable state dir — matches StateDirectory=melodize-companion in the systemd unit.
# ProtectSystem=strict makes /root/.config read-only, so we use this instead.
_STATE_DIR = pathlib.Path("/var/lib/melodize-companion")
_DEEMIX_CONFIG_DIR = _STATE_DIR / "deemix"


def _deezer_proxy_args(cfg: dict) -> list[str]:
    """Return curl proxy flags for Deezer requests, if a proxy is configured.

    Supports SOCKS5 (socks5://, socks5h://) and HTTP (http://, https://) proxies.
    Reads `deezer_proxy` from the companion config.
    """
    proxy = cfg.get("deezer_proxy", "").strip()
    if not proxy:
        return []
    # curl --socks5-hostname sends DNS through the proxy (required for SOCKS5
    # to avoid DNS leaks).  For HTTP proxies, curl handles CONNECT natively.
    if proxy.startswith("socks"):
        return ["--socks5-hostname", proxy]
    return ["--proxy", proxy]


def _validate_deezer_connectivity(arl: str, cfg: dict) -> tuple[bool, bool]:
    """Test if the server can reach Deezer's API and if the ARL is valid.

    Uses curl subprocess for SOCKS5 proxy support (urllib doesn't support
    SOCKS natively without PySocks).

    Returns (reachable, valid):
      (True, True)   — ARL confirmed valid
      (True, False)  — Deezer responded but ARL is expired/invalid
      (False, False) — server cannot reach Deezer (empty body, timeout, etc.)
    """
    url = (
        'https://www.deezer.com/ajax/gw-light.php'
        '?method=deezer.getUserData&api_version=1.0&api_token=&input=3'
    )
    arl = arl.strip()
    if not is_valid_arl(arl):
        return (True, False)
    try:
        cmd = [
            'curl', '-4', '-s', '-X', 'POST', '-d', '',
            '-H', 'User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36',
            # Read the cookie from stdin so the ARL never shows up in `ps`.
            '-K', '-',
        ]
        cmd.extend(_deezer_proxy_args(cfg))
        cmd.append(url)

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15,
                                input=f'cookie = "arl={arl}"\n')
        body = result.stdout.strip()
        if not body:
            log.warning("Deezer API returned empty body — server IP may be blocked")
            return (False, False)
        data = json.loads(body)
        # If Deezer returns a gateway/API error, treat as unreachable
        # rather than "ARL expired" (the request itself failed).
        if 'error' in data and data['error']:
            log.warning(f"Deezer API returned error: {data['error']}")
            return (False, False)
        user = data.get('results', {}).get('USER', {})
        user_id = user.get('USER_ID', 0)
        if isinstance(user_id, int) and user_id != 0:
            return (True, True)   # ARL valid
        else:
            return (True, False)  # ARL expired/invalid
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError) as e:
        log.warning(f"Deezer connectivity check failed: {e}")
        return (False, False)


def _write_deemix_arl(arl: str) -> None:
    """Persist ARL and high-quality artwork config so deemix picks them up."""
    _DEEMIX_CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    arl_path = _DEEMIX_CONFIG_DIR / ".arl"
    fd = os.open(arl_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(arl.strip())
    os.chmod(arl_path, 0o600)

    # Write/update config.json — only set artwork quality, leave everything else
    # at deemix defaults so we don't stomp on user-configured preferences.
    config_path = _DEEMIX_CONFIG_DIR / "config.json"
    try:
        existing = json.loads(config_path.read_text(encoding="utf-8")) if config_path.exists() else {}
    except Exception:
        existing = {}
    existing["embeddedArtworkSize"] = 1000  # XL (1000×1000) — default is 800→500px
    existing["localArtworkSize"] = 1000
    config_path.write_text(json.dumps(existing, indent=2), encoding="utf-8")


def _run_download(job_id: str, url: str, cfg: dict, deezer_arl: str = "") -> None:
    try:
        with _download_slots:
            _run_download_inner(job_id, url, cfg, deezer_arl)
    except Exception as e:
        # Safety net: ensure the job never gets stuck in "downloading" forever.
        log.exception(f"[job {job_id}] unexpected error")
        _update_job(job_id, status="error", error=str(e))


def _run_download_inner(job_id: str, url: str, cfg: dict, deezer_arl: str = "") -> None:
    _update_job(job_id, status="downloading")
    music_dir = cfg["music_dir"]
    is_deezer = is_deezer_url(url)
    effective_arl = deezer_arl or cfg.get("deezer_arl", "")

    if is_deezer:
        # deemix handles Deezer natively (including HiFi FLAC via ARL).
        # yt-dlp hard-blocks Deezer due to DRM detection.
        if not effective_arl:
            _update_job(job_id, status="error",
                        error="Deezer ARL not configured — add it in app Settings")
            return
        # Validate server-side Deezer connectivity before downloading.
        # This distinguishes "ARL expired" from "server can't reach Deezer"
        # (e.g. datacenter IP blocked by Deezer's bot protection).
        reachable, arl_valid = _validate_deezer_connectivity(effective_arl, cfg)
        if not reachable:
            _update_job(job_id, status="error",
                        error="Deezer unreachable from server — check server network or proxy")
            log.error(f"[job {job_id}] Deezer API unreachable from companion server")
            return
        if not arl_valid:
            _update_job(job_id, status="error",
                        error="Deezer session expired — update your ARL in Settings")
            log.error(f"[job {job_id}] Deezer ARL expired/invalid")
            return
        _write_deemix_arl(effective_arl)
        deemix = cfg.get("deemix_path", "deemix")
        # Pass the config dir so deemix finds the .arl file we just wrote.
        cmd = [deemix, "-b", "FLAC", "-p", music_dir, "--", url]
        err_label = "deemix"
    else:
        ytdlp = cfg.get("ytdlp_path", "yt-dlp")
        output_tmpl = os.path.join(music_dir, "%(artist,uploader)s - %(title)s.%(ext)s")
        cmd = [
            ytdlp,
            "--extract-audio",
            "--audio-format", cfg.get("download_format", "flac"),
            "--audio-quality", "0",
            "--output", output_tmpl,
            "--no-playlist",
            "--no-progress",
            "--add-metadata",
            "--",
            url,
        ]
        err_label = "yt-dlp"

    env = os.environ.copy()
    if is_deezer:
        # deemix uses XDG base dirs for config — it looks for
        # $XDG_CONFIG_HOME/deemix/.arl  (or ~/.config/deemix/.arl by default).
        # Setting XDG_CONFIG_HOME to our state dir makes deemix find the
        # .arl file we write at /var/lib/melodize-companion/deemix/.arl.
        env["XDG_CONFIG_HOME"] = str(_STATE_DIR)
        # Route Deezer traffic through proxy if configured (e.g. to bypass
        # geo-restrictions from servers in countries where Deezer is blocked).
        proxy = cfg.get("deezer_proxy", "").strip()
        if proxy:
            env["ALL_PROXY"] = proxy

    # Snapshot files before download so we can detect silent failures
    # (deemix sometimes exits 0 but produces no output file).
    def _get_files(directory: str) -> set:
        files = set()
        try:
            for root, _, fnames in os.walk(directory):
                for f in fnames:
                    files.add(os.path.join(root, f))
        except OSError:
            pass
        return files

    files_before = _get_files(music_dir)

    try:
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=600, env=env,
                                stdin=subprocess.DEVNULL)
        if result.returncode != 0:
            stderr = result.stderr[-800:]
            # Detect ARL login failure — deemix exits after EOF on stdin
            # when the stored ARL is invalid/expired.
            if is_deezer and ('paste here your arl' in stderr.lower()
                             or 'aborted' in stderr.lower()
                             or 'eoferror' in stderr.lower()
                             or 'login_via_arl' in stderr.lower()):
                # deemix ARL failure — but we already validated connectivity
                # above, so if we got here the ARL was accepted by the API
                # but deemix still failed. Could be a deemix-specific issue.
                _update_job(job_id, status="error",
                            error="Deezer download failed — deemix could not authenticate despite valid ARL")
                log.warning(f"[job {job_id}] deemix auth failed but server-side ARL validation passed")
            else:
                _update_job(job_id, status="error", error=stderr)
            log.error(f"[job {job_id}] {err_label} failed: {result.stderr[-200:]}")
        else:
            # deemix/yt-dlp exited 0 — but verify that a file was actually
            # created.  deemix can print "All done!" and exit 0 even when it
            # couldn't stream the track (e.g. subscription ended).
            files_after = _get_files(music_dir)
            new_files = files_after - files_before
            combined_output = (result.stderr + "\n" + result.stdout).lower()

            if not new_files:
                if ('can\'t stream' in combined_output or 'can not stream' in combined_output
                        or 'cannot stream' in combined_output):
                    err_msg = ("Deezer account cannot download at the desired quality — "
                               "your subscription may have ended. "
                               "Update your Deezer subscription or try a lower quality.")
                elif 'not available' in combined_output or 'unavailable' in combined_output:
                    err_msg = "Track is not available in your region or has been removed"
                elif 'drm' in combined_output and 'protected' in combined_output:
                    err_msg = "Track is DRM-protected and cannot be downloaded"
                else:
                    err_msg = ("Download tool reported success but no file was created — "
                               "the track may be unavailable or your Deezer subscription may have ended")
                _update_job(job_id, status="error", error=err_msg)
                log.error(f"[job {job_id}] false success: {err_msg}"
                          f"  (stderr tail: {result.stderr[-300:]})")
            else:
                _update_job(job_id, status="done")
                log.info(f"[job {job_id}] download complete — {len(new_files)} new file(s)")
    except subprocess.TimeoutExpired:
        _update_job(job_id, status="error", error="download timed out after 600s")
    except FileNotFoundError:
        _update_job(job_id, status="error", error=f"{err_label} not installed on server")
    except Exception as e:
        _update_job(job_id, status="error", error=str(e))


# ---------------------------------------------------------------------------

class _Handler(http.server.BaseHTTPRequestHandler):
    """One thread per request (see _Server). Shared state is lock-protected
    and every SQLite access opens its own connection."""

    # Drop idle/slow clients instead of letting them hold a worker forever.
    timeout = 30

    # Silence default access log; we use our own
    def log_message(self, fmt, *args):
        log.info(f"{self.address_string()} \"{fmt % args}\"")

    def log_error(self, fmt, *args):
        log.warning(f"{self.address_string()} \"{fmt % args}\"")

    # --- helpers ---

    def _send(self, code: int, body: dict) -> None:
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _auth(self) -> bool:
        key = self.headers.get("X-API-Key", "").encode("utf-8", "surrogateescape")
        expected = self.server.cfg["api_key"].encode("utf-8")
        if not hmac.compare_digest(key, expected):
            self._send(403, {"error": "invalid or missing API key"})
            return False
        return True

    def _body(self) -> dict:
        """Parse a JSON object body. Raises ValueError on bad input."""
        n = int(self.headers.get("Content-Length", 0))
        if n < 0 or n > MAX_BODY_BYTES:
            raise ValueError("request body too large")
        body = json.loads(self.rfile.read(n)) if n > 0 else {}
        if not isinstance(body, dict):
            raise ValueError("JSON body must be an object")
        return body

    def _lookup_path(self, song_id: str) -> Optional[str]:
        """Return relative path (filename) for a Navidrome song ID, or None."""
        conn = sqlite3.connect(self.server.cfg["navidrome_db"], check_same_thread=False)
        try:
            cur = conn.execute("SELECT path FROM media_file WHERE id = ?", (song_id,))
            row = cur.fetchone()
            return row[0] if row else None
        finally:
            conn.close()

    # --- routing ---

    def _guarded(self, fn) -> None:
        """Turn unexpected exceptions into a JSON 500 instead of a dropped
        connection, so the app sees a clean error."""
        try:
            fn()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception:
            log.exception("Unhandled error for %s %s", self.command, self.path)
            try:
                self._send(500, {"error": "internal server error"})
            except Exception:
                pass

    def do_GET(self):
        self._guarded(self._do_get)

    def do_DELETE(self):
        self._guarded(self._do_delete)

    def do_POST(self):
        self._guarded(self._do_post)

    def _do_get(self):
        p = self.path.split("?")[0]
        if p == "/health":
            self._send(200, {"status": "ok", "version": "1.3.0"})
            return

        # Download job status
        m = re.match(r"^/api/songs/download/([A-Za-z0-9_-]+)$", p)
        if m:
            if not self._auth():
                return
            jid = m.group(1)
            with _jobs_lock:
                job = _jobs.get(jid)
            if not job:
                self._send(404, {"error": "job not found"})
            else:
                self._send(200, job)
            return

        # Mix transition job status
        m = re.match(r"^/api/audio/mix-transition/([A-Za-z0-9_-]+)$", p)
        if m:
            if not self._auth():
                return
            jid = m.group(1)
            with _jobs_lock:
                job = _jobs.get(jid)
            if not job:
                self._send(404, {"error": "mix job not found"})
            else:
                self._send(200, job)
            return

        # Audio analysis — poll batch job
        m = re.match(r"^/api/audio/analyze-batch/([A-Za-z0-9_-]+)$", p)
        if m:
            if not self._auth():
                return
            jid = m.group(1)
            job = analysis_jobs.get_job(jid)
            if not job:
                self._send(404, {"error": "analysis job not found"})
            else:
                # Strip internal song list from response
                resp = {k: v for k, v in job.items() if k != "songs"}
                self._send(200, resp)
            return

        # Audio analysis — get all cached results
        if p == "/api/audio/analysis":
            if not self._auth():
                return
            results = self.server.analysis_cache.get_all_results()
            self._send(200, {"results": results})
            return

        # Audio analysis — get single cached result
        m = re.match(r"^/api/audio/analysis/([^/?]+)$", p)
        if m:
            if not self._auth():
                return
            song_id = m.group(1)
            result = self.server.analysis_cache.get(song_id)
            if not result:
                self._send(404, {"error": "analysis not found"})
            else:
                self._send(200, result)
            return

        # Serve cached transition WAV
        m = re.match(r"^/api/audio/transition/([A-Za-z0-9_-]+\.wav)$", p)
        if m:
            if not self._auth():
                return
            name = m.group(1)
            mix_dir = pathlib.Path(
                self.server.cfg.get("mix_cache_dir",
                                    "/var/lib/melodize-companion/mix_cache")
            )
            wav_path = mix_dir / name
            if not wav_path.is_file():
                self._send(404, {"error": "transition not found"})
                return
            size = wav_path.stat().st_size
            self.send_response(200)
            self.send_header("Content-Type", "audio/wav")
            self.send_header("Content-Length", str(size))
            # Authenticated content: shared caches (reverse proxies) must
            # not store it and serve it to clients without the API key.
            self.send_header("Cache-Control", "private, max-age=86400")
            self.end_headers()
            with wav_path.open("rb") as f:
                while chunk := f.read(64 * 1024):
                    self.wfile.write(chunk)
            return

        self._send(404, {"error": "not found"})

    def _do_delete(self):
        if not self._auth():
            return
        m = re.match(r"^/api/songs/([^/?]+)$", self.path.split("?")[0])
        if not m:
            self._send(404, {"error": "not found"})
            return
        song_id = m.group(1)
        cfg = self.server.cfg

        try:
            rel = self._lookup_path(song_id)
            if rel is None:
                self._send(404, {"error": "song not found in database"})
                return

            music_root = pathlib.Path(cfg["music_dir"]).resolve()
            full = (music_root / rel).resolve()
            if not str(full).startswith(str(music_root) + "/"):
                log.error(f"Path traversal blocked: {full} not under {music_root}")
                self._send(403, {"error": "path outside music directory"})
                return

            if not full.exists():
                # Already gone — treat as success
                log.warning(f"File already missing: {full}")
                self._send(200, {"ok": True, "note": "file was already absent"})
                return

            full.unlink()
            log.info(f"Deleted: {full}")
            self._send(200, {"ok": True})

        except Exception as e:
            log.exception("Unexpected error during delete")
            self._send(500, {"error": str(e)})

    def _do_post(self):
        if not self._auth():
            return
        p = self.path.split("?")[0]

        if p == "/api/songs/download":
            self._handle_download_start()
        elif p == "/api/audio/analyze-batch":
            self._handle_analyze_batch()
        elif p == "/api/audio/mix-transition":
            self._handle_mix_transition()
        else:
            self._send(404, {"error": "not found"})

    def _handle_download_start(self):
        try:
            body = self._body()
        except (json.JSONDecodeError, ValueError):
            self._send(400, {"error": "invalid JSON body"})
            return

        url = body.get("url")
        url = url.strip() if isinstance(url, str) else ""
        if not url:
            self._send(400, {"error": "'url' is required"})
            return
        err = validate_download_url(url)
        if err:
            self._send(400, {"error": err})
            return
        deezer_arl = body.get("deezer_arl")
        deezer_arl = deezer_arl.strip() if isinstance(deezer_arl, str) else ""
        if deezer_arl and not is_valid_arl(deezer_arl):
            self._send(400, {"error": "deezer_arl is not a valid ARL"})
            return

        job_id = secrets.token_urlsafe(12)
        _new_job(job_id, url)
        t = threading.Thread(
            target=_run_download,
            args=(job_id, url, self.server.cfg, deezer_arl),
            daemon=True,
        )
        t.start()
        self._send(202, {"job_id": job_id, "status": "queued"})

    # --- Audio analysis ---

    def _handle_analyze_batch(self):
        """Start a batch analysis of the song library."""
        try:
            body = self._body()
        except (json.JSONDecodeError, ValueError):
            self._send(400, {"error": "invalid JSON body"})
            return

        # Build the list of songs to analyze from Navidrome DB
        song_ids = body.get("song_ids")  # optional subset
        if song_ids is not None and (
                not isinstance(song_ids, list)
                or len(song_ids) > MAX_BATCH_SONG_IDS
                or not all(isinstance(s, str) for s in song_ids)):
            self._send(400, {"error": f"song_ids must be a list of at most "
                                      f"{MAX_BATCH_SONG_IDS} strings"})
            return
        conn = sqlite3.connect(self.server.cfg["navidrome_db"], check_same_thread=False)
        try:
            if song_ids:
                # Chunk the IN (...) list: SQLite caps bound parameters.
                rows = []
                ids = list(dict.fromkeys(song_ids))
                for i in range(0, len(ids), _SQLITE_CHUNK):
                    chunk = ids[i:i + _SQLITE_CHUNK]
                    placeholders = ",".join("?" for _ in chunk)
                    rows.extend(conn.execute(
                        f"SELECT id, path FROM media_file WHERE id IN ({placeholders})",
                        chunk,
                    ).fetchall())
            else:
                rows = conn.execute("SELECT id, path FROM media_file").fetchall()
        finally:
            conn.close()

        music_dir = self.server.cfg["music_dir"]
        songs_to_check = []
        for song_id, rel_path in rows:
            full_path = os.path.join(music_dir, rel_path) if not os.path.isabs(rel_path) else rel_path
            try:
                st = os.stat(full_path)
                songs_to_check.append({
                    "song_id": song_id,
                    "file_path": full_path,
                    "mtime": st.st_mtime,
                    "size": st.st_size,
                })
            except OSError:
                log.warning("Cannot stat %s — skipping", full_path)

        # Filter to stale songs only
        cache = self.server.analysis_cache
        stale = cache.get_all_stale(songs_to_check)
        skipped = len(songs_to_check) - len(stale)

        if not stale:
            # Everything is already cached — return all results
            all_results = cache.get_all_results()
            self._send(200, {
                "status": "done",
                "total": len(songs_to_check),
                "analyzed": len(all_results),
                "skipped": skipped,
                "failed": 0,
                "results": all_results,
            })
            return

        job_id = f"ana_{secrets.token_urlsafe(8)}"
        analysis_jobs.prune(JOB_TTL_SECONDS)
        # Store full song list for progress tracking
        analysis_jobs.create_job(job_id, songs_to_check)
        analysis_jobs.update_job(job_id, status="in_progress", skipped=skipped)

        # Run analysis in background via the server's thread pool
        executor = self.server.executor
        executor.submit(self._run_analysis_batch, job_id, stale, cache)

        self._send(202, {
            "job_id": job_id,
            "status": "in_progress",
            "total": len(songs_to_check),
            "analyzed": 0,
            "skipped": skipped,
            "failed": 0,
        })

    def _run_analysis_batch(self, job_id: str, stale: list[dict], cache: AnalysisCache):
        """Analyze stale songs in the background."""
        analyzed = 0
        failed = 0
        for song in stale:
            try:
                result = analyze_song(song["file_path"])
                if result:
                    cache.set(
                        song["song_id"], song["file_path"],
                        song["mtime"], song["size"], result,
                    )
                    analysis_jobs.add_result(job_id, {
                        "song_id": song["song_id"],
                        **result,
                    })
                    analyzed += 1
                else:
                    failed += 1
                    # Still mark as analyzed so we don't retry on next batch
                    cache.set(
                        song["song_id"], song["file_path"],
                        song["mtime"], song["size"],
                        {"bpm": None, "key": None, "energy": None},
                    )
            except Exception as e:
                log.error("Analysis error for %s: %s", song["file_path"], e)
                failed += 1

            analysis_jobs.update_job(
                job_id, analyzed=analyzed, failed=failed,
            )

        analysis_jobs.update_job(job_id, status="done")
        log.info(
            "Batch analysis %s done: %d analyzed, %d failed",
            job_id, analyzed, failed,
        )

    # --- Transition mixing ---

    def _handle_mix_transition(self):
        """Generate a time-stretched crossfade mix between two songs."""
        try:
            body = self._body()
        except (json.JSONDecodeError, ValueError):
            self._send(400, {"error": "invalid JSON body"})
            return

        song_a_id = body.get("song_a_id")
        song_b_id = body.get("song_b_id")
        song_a_id = song_a_id.strip() if isinstance(song_a_id, str) else ""
        song_b_id = song_b_id.strip() if isinstance(song_b_id, str) else ""
        if not song_a_id or not song_b_id:
            self._send(400, {"error": "song_a_id and song_b_id are required"})
            return

        try:
            mix_duration = float(body.get("mix_duration", 10))
        except (TypeError, ValueError):
            self._send(400, {"error": "mix_duration must be a number"})
            return
        if mix_duration != mix_duration:  # NaN
            self._send(400, {"error": "mix_duration must be a number"})
            return
        if not 2.0 <= mix_duration <= 30.0:
            self._send(400, {"error": "mix_duration must be between 2 and 30 seconds"})
            return

        # Use an opaque, URL-safe cache key. Navidrome IDs may contain
        # characters that the transition route intentionally rejects.
        mix_key = hashlib.sha256(
            f"{song_a_id}\\0{song_b_id}\\0{mix_duration:.3f}".encode("utf-8")
        ).hexdigest()[:32]

        # Check cache first
        mix_dir = pathlib.Path(
            self.server.cfg.get("mix_cache_dir",
                                "/var/lib/melodize-companion/mix_cache")
        )
        mix_dir.mkdir(parents=True, exist_ok=True)
        mix_filename = f"{mix_key}.wav"
        mix_path = mix_dir / mix_filename

        if mix_path.is_file():
            # Cached — return immediately
            self._send(200, {
                "status": "ok",
                "cached": True,
                "transition_id": mix_filename.replace(".wav", ""),
                "url": f"/api/audio/transition/{mix_filename}",
            })
            return

        # Look up file paths from Navidrome DB
        conn = sqlite3.connect(self.server.cfg["navidrome_db"], check_same_thread=False)
        try:
            cur = conn.execute(
                "SELECT id, path FROM media_file WHERE id IN (?, ?)",
                (song_a_id, song_b_id),
            )
            paths = {row[0]: row[1] for row in cur.fetchall()}
        finally:
            conn.close()

        music_dir = self.server.cfg["music_dir"]
        path_a = paths.get(song_a_id)
        path_b = paths.get(song_b_id)
        if not path_a or not path_b:
            self._send(404, {"error": "song not found in database"})
            return

        full_a = os.path.join(music_dir, path_a) if not os.path.isabs(path_a) else path_a
        full_b = os.path.join(music_dir, path_b) if not os.path.isabs(path_b) else path_b

        # Look up BPM from analysis cache
        cache_a = self.server.analysis_cache.get(song_a_id)
        cache_b = self.server.analysis_cache.get(song_b_id)
        bpm_a = float(cache_a["bpm"]) if cache_a and cache_a.get("bpm") else 120.0
        bpm_b = float(cache_b["bpm"]) if cache_b and cache_b.get("bpm") else 120.0
        tail_a = float(cache_a["tail_silence"]) if cache_a and cache_a.get("tail_silence") else 0.0
        key_a = str(cache_a["key"]) if cache_a and cache_a.get("key") else None
        key_b = str(cache_b["key"]) if cache_b and cache_b.get("key") else None

        # Estimate mix quality for the response.
        quality = estimate_mix_quality(bpm_a, bpm_b, key_a=key_a, key_b=key_b)

        # Generate mix in executor to avoid blocking
        job_id = f"mix_{secrets.token_urlsafe(8)}"
        _register_job(job_id, {
            "status": "mixing",
            "song_a": song_a_id,
            "song_b": song_b_id,
            "url": None,
            "quality": quality,
        })

        executor = self.server.executor
        executor.submit(
            self._run_mix_job,
            job_id, full_a, full_b, bpm_a, bpm_b, mix_duration, mix_path,
            tail_a,
        )

        self._send(202, {
            "job_id": job_id,
            "status": "mixing",
            "quality": quality,
        })

    def _run_mix_job(self, job_id, path_a, path_b, bpm_a, bpm_b,
                     mix_duration, mix_path, tail_silence_a=0.0):
        """Generate transition mix in background."""
        try:
            wav_bytes = generate_transition(
                path_a, path_b, bpm_a, bpm_b, mix_duration,
                tail_silence_a=tail_silence_a,
            )
            if wav_bytes:
                # Write then rename so a concurrent GET never serves a
                # half-written file.
                tmp = mix_path.with_suffix(f".{secrets.token_hex(4)}.tmp")
                tmp.write_bytes(wav_bytes)
                os.replace(tmp, mix_path)
                mix_filename = mix_path.name
                with _jobs_lock:
                    _jobs[job_id] = {
                        "status": "done",
                        "url": f"/api/audio/transition/{mix_filename}",
                        "transition_id": mix_filename.replace(".wav", ""),
                    }
                log.info("Transition mix %s done", job_id)
            else:
                with _jobs_lock:
                    _jobs[job_id] = {
                        "status": "fallback",
                        "reason": "bpm_gap_too_large or generation failed",
                        "fallback_method": "crossfade",
                    }
        except Exception as e:
            log.exception("Mix job %s failed", job_id)
            with _jobs_lock:
                _jobs[job_id] = {"status": "error", "error": str(e)}


# ---------------------------------------------------------------------------

class _Server(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, handler, cfg):
        self.cfg = cfg
        self.executor = ThreadPoolExecutor(max_workers=cfg.get("analysis_threads", 2))
        self.analysis_cache = AnalysisCache(
            cfg.get("analysis_cache_path",
                    "/var/lib/melodize-companion/analysis_cache.db")
        )
        super().__init__(addr, handler)


def main():
    cfg = load_config()
    port = int(cfg.get("port", 8765))
    # Set "bind" to 127.0.0.1 when a reverse proxy on the same host fronts the
    # companion, so the plain-HTTP port isn't reachable from the network.
    bind = cfg.get("bind", "0.0.0.0")
    srv = _Server((bind, port), _Handler, cfg)
    log.info(f"melodize-companion v1.3 — listening on {bind}:{port}")
    log.info(f"  music_dir:     {cfg['music_dir']}")
    log.info(f"  navidrome_db:  {cfg['navidrome_db']}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        log.info("Shutting down")


if __name__ == "__main__":
    main()
